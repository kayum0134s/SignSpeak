# SignSpeak Environment Configuration Template
# Copy this file to .env and configure as needed.

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5500,*
